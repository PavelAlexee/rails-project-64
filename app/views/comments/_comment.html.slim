.card.mt-2.rounded-0 id="comment-#{comment.id}"
  .card-header.border-0
    span.me-2
      - if comment.user.present?
        = comment.user.email
      - else
        span.text-muted [Удаленный пользователь]
    span.fs-6.text-muted
  
  .card-body.border-0
    p.card-text = comment.content
  
  - if user_signed_in?
    .card-footer.border-0
      = link_to 'ответить', '#', class: 'fs-6 text-decoration-underline text-lowercase',
                                      type: 'button',
                                      aria_exanded: 'false',
                                      aria_controls: "response_comment-#{comment.id}",
                                      data: { bs_target: "#response_comment-#{comment.id}",
                                              bs_toggle: 'collapse' }

      .ms-2.collapse id="response_comment-#{comment.id}"
        = simple_form_for @comment, url: post_comments_path(@post) do |f|
          = f.input :content, as: :text, label: false
          = f.input :parent_id, as: :hidden, input_html: { value: comment.id }
          = f.button :submit, 'Оставить комментарий', class: 'btn-primary mt-2'
        
  - if children.any?
    .card-body.border-0.ps-4
      - children.each do |child_data|
        = render 'comments/comment', 
                 comment: child_data[:comment], 
                 children: child_data[:children]
