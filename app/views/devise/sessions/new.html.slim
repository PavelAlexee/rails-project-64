.container
  .row.justify-content-center
    .col-md-6.col-lg-4
      .card.mt-5
        .card-body
          h2.h3.mb-3.fw-normal.text-center Войти
          
          = form_for(resource, as: resource_name, url: session_path(resource_name)) do |f|
            .form-floating.mb-3
              = f.email_field :email, 
                              autofocus: true, 
                              autocomplete: "email", 
                              class: "form-control", 
                              id: "floatingInput"
              = f.label :email, for: "floatingInput"

            .form-floating.mb-3
              = f.password_field :password, 
                                autocomplete: "current-password", 
                                class: "form-control", 
                                id: "floatingPassword"
              = f.label :password, "Пароль", for: "floatingPassword"

            - if devise_mapping.rememberable?
              .checkbox.mb-3
                = f.check_box :remember_me, class: "form-check-input"
                = f.label :remember_me, "Запомнить меня", class: "form-check-label ms-2"

            = f.submit "Войти", class: "w-100 btn btn-lg btn-primary mb-3"
