= form_with model: @post do |f|

  .field.mb-3
    = f.label :title, 'Заголовок', class: 'form-label'
    = f.text_field :title, class: 'form-control', required: true

  .field.mb-3
    = f.label :category_id, 'Категория', class: 'form-label'
    = f.collection_select :category_id, @categories, :id, :name, { prompt: 'Выберете категорию' }, class: 'form-select', required: true

  .field.mb-3
    = f.label :body, 'Содержание', class: 'form-label'
    = f.text_area :body, rows: 10, class: 'form-control', required: true

  .actions
    = f.submit 'Опубликовать', class: 'btn btn-primary'
