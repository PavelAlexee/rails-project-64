h1.card-title = @post.title
p.card-text = simple_format(@post.body)
hr.mt-4
small.text-muted
  | Категория: #{@post.category.name} |
  | Автор: #{@post.creator.first_name} |
  | Создано: #{time_ago_in_words(@post.created_at)} назад

- if user_signed_in? && current_user == @post.creator
  .mt-4
    = link_to 'Редактировать пост', edit_post_path(@post.id), class: 'btn btn-outline-secondary'

    = button_to "Удалить",
                post_path(@post.id),
                data: { turbo_confirm: 'Вы уверены?' },
                method: :delete,
                class: 'btn btn-outline-danger mt-1'

.mt-5
  h3 Комментарии (#{@post.comments.count})
  - if user_signed_in?
    = simple_form_for @comment, url: post_comments_path(@post) do |f|
      = f.input :content, as: :text, label: false
      = f.input :parent_id, as: :hidden, input_html: { value: nil }
      = f.button :submit, 'Оставить комментарий',class: 'btn-primary mb-4'
  - @comments.each do |comment|
    .card.mt-2.rounded-0 id="comment-#{comment.id}"
      .card-header.border-0
        span.me-2
          - if comment.user.present?
            = comment.user.email
          - else
            span.text-muted [Удаленный пользователь]
        span.fs-6.text-muted
          = l(comment.created_at, format: :short)
      .card-body.border-0
        p.card-text = comment.content
      - if user_signed_in?
        .card-footer.border-0
            = render 'posts/comment_form', comment: comment
      = render 'posts/children_comments', comment: comment

= link_to 'Назад', root_path, class: 'btn btn-outline-primary mt-3'
